              "max": 65535,
              "step": 1,
              "label": {
                "en": "Port",
                "nl": "Poort"
              }
            },
            {
              "id": "unit_id",
              "type": "number",
              "value": 1,
              "min": 1,
              "max": 247,
              "step": 1,
              "label": {
                "en": "Modbus address meter",
                "nl": "Modbus-adres meter"
              },
              "hint": {
                "en": "Shown on the meter display (default 1).",
                "nl": "Staat op het display van de meter (standaard 1)."
              }
            },
            {
              "id": "protocol",
              "type": "dropdown",
              "value": "auto",
              "label": {
                "en": "Protocol",
                "nl": "Protocol"
              },
              "hint": {
                "en": "Automatic tries Modbus TCP first, then RTU over TCP (transparent converter).",
                "nl": "Automatisch probeert eerst Modbus TCP, daarna RTU over TCP (transparante converter)."
              },
              "values": [
                {
                  "id": "auto",
                  "label": {
                    "en": "Automatic",
                    "nl": "Automatisch"
                  }
                },
                {
                  "id": "tcp",
                  "label": {
                    "en": "Modbus TCP (gateway mode)",
                    "nl": "Modbus TCP (gateway-modus)"
                  }
                },
                {
                  "id": "rtu",
                  "label": {
                    "en": "Modbus RTU over TCP (transparent)",
                    "nl": "Modbus RTU over TCP (transparant)"
                  }
                }
              ]
            },
            {
              "id": "polling",
              "type": "number",
              "value": 10,
              "min": 2,
              "max": 3600,
              "step": 1,
              "units": {
                "en": "s"
              },
              "label": {
                "en": "Polling interval",
                "nl": "Pollinginterval"
              }
            },
            {
              "id": "invert",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Invert direction",
                "nl": "Richting omkeren"
              },
              "hint": {
                "en": "Enable when the meter is wired the other way round (negative power while charging): swaps sign and import/export.",
                "nl": "Aanzetten als de meter omgekeerd is aangesloten (negatief vermogen tijdens het laden): keert het teken om en wisselt afname/teruglevering."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Charging sessions",
            "nl": "Laadsessies"
          },
          "children": [
            {
              "id": "start_threshold",
              "type": "number",
              "value": 1000,
              "min": 10,
              "max": 50000,
              "step": 10,
              "units": {
                "en": "W"
              },
              "label": {
                "en": "Charging starts above",
                "nl": "Laden start boven"
              }
            },
            {
              "id": "stop_threshold",
              "type": "number",
              "value": 200,
              "min": 0,
              "max": 50000,
              "step": 10,
              "units": {
                "en": "W"
              },
              "label": {
                "en": "Charging stops below",
                "nl": "Laden stopt onder"
              }
            },
            {
              "id": "stop_delay",
              "type": "number",
              "value": 300,
              "min": 0,
              "max": 7200,
              "step": 10,
              "units": {
                "en": "s"
              },
              "label": {
                "en": "Stop delay",
                "nl": "Stopvertraging"
              },
              "hint": {
                "en": "Power must stay below the stop threshold this long before the session ends (cars pause while balancing or preconditioning).",
                "nl": "Zo lang moet het vermogen onder de stopdrempel blijven voor de sessie eindigt (auto's pauzeren soms tijdens balanceren of voorverwarmen)."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Extra registers (read only)",
            "nl": "Extra registers (alleen lezen)"
          },
          "children": [
            {
              "id": "custom_registers",
              "type": "textarea",
              "value": "# naam ; input|holding ; adres ; type ; factor ; eenheid\n# Voorbeelden (DTSU666, holding, FLOAT32):\n# Blindvermogen ; holding ; 0x201A ; FLOAT32 ; 0.1 ; var\n# Spanning L1-L2 ; holding ; 0x2000 ; FLOAT32 ; 0.1 ; V\n# Arbeidsfactor L1 ; holding ; 0x202C ; FLOAT32 ; 0.001 ;\n",
              "label": {
                "en": "Extra registers",
                "nl": "Extra registers"
              },
              "hint": {
                "en": "One per line: name ; input|holding ; address (decimal or 0x hex) ; type (FLOAT32, UINT16, INT16, UINT32, INT32) ; factor ; unit. Lines starting with # are ignored.",
                "nl": "Eén per regel: naam ; input|holding ; adres (decimaal of 0x-hex) ; type (FLOAT32, UINT16, INT16, UINT32, INT32) ; factor ; eenheid. Regels die met # beginnen worden genegeerd."
              }
            }
          ]
        }
