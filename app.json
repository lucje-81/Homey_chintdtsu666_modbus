            "name": "name",
            "type": "string",
            "title": {
              "en": "Name",
              "nl": "Naam"
            },
            "example": "Blindvermogen"
          },
          {
            "name": "value",
            "type": "number",
            "title": {
              "en": "Value",
              "nl": "Waarde"
